---
/** The opening image of a book or chapter (the old header images), as a frontispiece. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;
---
<figure class="plate">
  <Image
    src={src}
    alt={alt}
    widths={[480, 760, 1080, 1440].filter((w) => w <= src.width)}
    sizes="(min-width: 48rem) 44rem, calc(100vw - 2rem)"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</figure>

<style>
  .plate {
    margin: 0;
  }
  .plate img {
    inline-size: 100%;
    max-block-size: 26rem;
    object-fit: contain;
    border-radius: var(--radius);
  }
</style>
