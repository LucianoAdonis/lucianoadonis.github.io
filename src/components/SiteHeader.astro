---
import Search from './Search.astro';

interface Props {
  /** On the home page the masthead carries the name, so the header drops it. */
  home?: boolean;
}
const { home = false } = Astro.props;
---
<header class="site-header">
  {home ? <span /> : <a class="wordmark" href="/">Luciano's Library</a>}
  <button class="search-open" type="button" popovertarget="search" aria-keyshortcuts="/">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <span>Search</span>
    <kbd aria-hidden="true">/</kbd>
  </button>
</header>
<Search />

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--gutter);
    border-bottom: 1px solid var(--rule);
  }
  .wordmark {
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--ink);
    padding-block: var(--space-2);
  }
  .wordmark:hover {
    color: var(--accent);
  }
  .search-open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2.75rem;
    padding: 0 var(--space-3);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .search-open:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
    background: var(--paper-2);
  }
  @media (max-width: 30rem) {
    .search-open kbd {
      display: none;
    }
  }
</style>
